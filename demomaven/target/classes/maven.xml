<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here <bean id="programmer" class="com.example.programmer" scope = "prototype"> -->
    <bean id="programmer" class="com.example.programmer">
     <property name="age" value="56">
    </property>
    <property name="lap" ref="lap">
    </property>

    <constructor-arg value = "34"></constructor-arg>
    </bean>
    <!-- <bean id="programmer1" class="com.example.programmer">
    </bean> -->
    <bean id = "lap" class="com.example.laptop">
    </bean>
</beans>